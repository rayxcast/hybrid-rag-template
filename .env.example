# Copy this file to .env and replace placeholders with real values.
# Never commit real API keys or pasted output from `docker compose config`.

# Provider keys
OPENAI_API_KEY=replace_me
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Provider selection
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=1000000

DENSE_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBED_BATCH_SIZE=128

# Retrieval
RETRIEVAL_MODE=hybrid
USE_RERANKER=true
USE_CACHE=true
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.92
COLLECTION_NAME=hybrid_rag_docs

# Internal Docker Compose service URLs
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
RERANKER_URL=http://reranker:8001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# API safety defaults
ALLOW_PATH_INGEST=false
MAX_UPLOAD_BYTES=25000000
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md
QUERY_MAX_CHARS=4000

# Optional template API-key auth for /ingest/ and /query/
API_KEY_AUTH_ENABLED=false
API_KEYS=

# Gemini demo alternative:
# GOOGLE_API_KEY=replace_me
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# DENSE_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=1536
# EMBED_BATCH_SIZE=100
